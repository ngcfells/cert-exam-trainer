{
  "name": "cert-exam-trainer",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "cross-env VITE_REPORT_URL=https://relay.e2e.test VITE_TURNSTILE_SITEKEY=e2e-sitekey vite build",
    "build:single": "cross-env SINGLE=1 vite build",
    "build:e2e": "cross-env SINGLE=1 VITE_BANK=fixture vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e-dev": "playwright test -c playwright.dev.config.ts",
    "check-bounds": "npm run build:single && playwright test --project=bounds",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build:check && npm run build:single && cross-env CHECK=1 npm run test && npm run build:e2e && npm run test:e2e",
    "deploy": "vite-node scripts/deploy.ts --",
    "hashes": "vite-node scripts/hashes.ts --",
    "md-to-pack": "vite-node scripts/md-to-pack.ts --",
    "draft:ollama": "vite-node scripts/draft-ollama.ts --",
    "check-drafts": "vite-node scripts/check-drafts.ts --",
    "harvest-acronyms": "vite-node scripts/harvest-acronyms.ts --",
    "expand-acronyms": "vite-node scripts/expand-acronyms.ts --",
    "alternate-acronyms": "vite-node scripts/alternate-acronyms.ts --",
    "check-primer": "vite-node scripts/check-primer.ts --"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
